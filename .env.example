# Bază de date (SQLite local; în producție folosește Postgres și schimbă provider în prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret pentru sesiuni (min. 32 caractere aleatorii)
AUTH_SECRET="schimba-ma-cu-un-secret-lung-si-aleator-1234567890"

# URL public al aplicației
APP_URL="http://localhost:3000"

# Emailul contului de administrator (poate publica videoclipuri în galeria publică)
ADMIN_EMAIL="firstonecoffee@gmail.com"

# Claude — scrie scenariile
ANTHROPIC_API_KEY=""

# Stripe — abonamente lunare
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC=""   # price_... recurent lunar
STRIPE_PRICE_PRO=""     # price_... recurent lunar

# Generator video: "mock" (dezvoltare) sau "replicate"
VIDEO_PROVIDER="mock"
REPLICATE_API_TOKEN=""
# Modelul Replicate image-to-video folosit (ex. owner/model). Verifică licența și politica de conținut a modelului.
REPLICATE_MODEL=""
